# MatQuant Mamba GitHub Repository .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints

# Virtual environments
venv/
env/
ENV/

# IDE files
.idea/
.vscode/
*.code-workspace

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log
logs/

# Model files (large binaries)
*.pt
*.pkl
*.h5

# Results directories that are generated by running the code
*_results/
results/
data/sp500/
financial_logs/
mft_logs/
analysis_summary/
ensemble/
flipped_results/
flipped_plots/
flipped_summary/
matquant_results/
fast_matquant_results/
mft_results/
model_comparison/
portfolio_comparison/
enhanced_comparison/
mft_comparison/
plots/
summary/

# Keep only the demo/example data files
data/*
!data/AAPL_1min.csv
!data/AAPL_5min.csv
!data/AAPL_30min.csv
!data/AAPL_60min.csv
!data/IBM_1min.csv
!data/IBM_5min.csv
!data/IBM_30min.csv
!data/IBM_60min.csv

# Extra files not needed for the blackbox demo
mft_predictions.png
matquant_demo_results.png
matquant_demo_training.png
straddle_profile.png
trading_strategy_plot.png
predictions_plot.png
test_predictions.png

# Only include the files needed for the blackbox demo
# Exclude experimental scripts and tests
*.backup
extended_matquant_test.py
fast_matquant_test.py
fetch_alpha_vantage_*.py
fetch_stock_data.py
financial_*.py
fix_*.py
hft_mamba_simulation.py
matquant_*.py
mft_*.py
multi_timeframe_*.py
options_analysis.py
paper.md
run_financial_training.py
run_*_backtest.sh
simplified_matquant_test.py
summarize_flipped.py
test_*.py
analyze_*.py
compare_*.py 