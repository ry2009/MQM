# MQM GitHub Repository .gitignore

# Exclude everything that could reveal implementation details
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Exclude all Python files except the essential formatter
*.py
!format_results.py

# Exclude all Jupyter notebooks
*.ipynb

# Exclude analysis files and folders
bit_analysis/
tca_results*/
simplified_tests/
MatQuant_Mamba_Backtest_Summary.md
