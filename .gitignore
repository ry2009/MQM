setup_and_test.py
transaction_costs.py
walkforward_testing.py

# Exclude test data files
intraday*.csv

# Keep only the essential shell scripts
!run_blackbox_model.sh
!run_hf_portfolio.sh
!test_blackbox.sh

# Virtual environment
venv/
.env

# Editor specific files
